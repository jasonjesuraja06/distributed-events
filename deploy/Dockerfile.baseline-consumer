FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download || true
COPY . .
RUN CGO_ENABLED=0 go build -o /out/baseline-consumer ./cmd/baseline-consumer

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/baseline-consumer /baseline-consumer
USER nonroot:nonroot
EXPOSE 9101
ENTRYPOINT ["/baseline-consumer"]
